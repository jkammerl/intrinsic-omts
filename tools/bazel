# Bazel wrapper, run by Bazelisk in place of Bazel. On arm64 hosts it adds
# --config=arm64 (see .bazelrc) to commands that accept build options, since
# .bazelrc cannot select configs by host CPU.
set -euo pipefail

BAZEL="${BAZEL_REAL:-bazel}"

case "$(uname -m)" in
  aarch64|arm64) ;;
  *) exec "${BAZEL}" "$@" ;;
esac

# Startup options come before the command.
args=("$@")
i=0
while [[ ${i} -lt ${#args[@]} && "${args[${i}]}" == -* ]]; do
  i=$((i + 1))
done

if [[ ${i} -lt ${#args[@]} ]]; then
  case "${args[${i}]}" in
    aquery|build|coverage|cquery|fetch|info|mobile-install|print_action|query|run|test)
      exec "${BAZEL}" "${args[@]:0:$((i + 1))}" --config=arm64 "${args[@]:$((i + 1))}"
      ;;
  esac
fi
exec "${BAZEL}" "$@"
